{
  "buildCommand": "node sync-home-drive.mjs && node build-project-pages.mjs",
  "installCommand": "npm install",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/projects.html", "destination": "/home.html", "permanent": false },
    { "source": "/projects/:slug*", "destination": "/home.html", "permanent": false }
  ]
}
